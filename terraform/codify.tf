# Codify stage: the agent drafts, the change is verified, a pull request opens.
#
# A SEPARATE role from detection, deliberately. Detection reads the estate and Terraform state;
# codify invokes a model and holds a write credential for the repository. Neither needs the
# other's permissions, and merging them would produce one principal that can read the whole
# estate AND write to the repository - the single most useful credential in the system to
# compromise.
#
# What this role can do:
#   - invoke one Bedrock model
#   - read detection's artifacts, and the git credential
#   - nothing else. No Terraform state access at all, not even read: the codify stage plans
#     against a checkout, and a plan that needs state would mean it was reading the estate.
#
# So the worst case for a fully compromised codify worker is a pull request containing something
# unauthorized - which the verifier rejects before publication, and which a human would have to
# merge even if it got through.

# Looked up rather than created: the key is generated by GitHub and put in place out of band,
# so Terraform should reference it, not own it. Owning it would mean a destroy takes the
# credential with it.
data "aws_secretsmanager_secret" "github_app_key" {
  count = var.enable_codify && var.github_app_key_secret_id != "" ? 1 : 0
  name  = var.github_app_key_secret_id
}

resource "aws_cloudwatch_log_group" "codify" {
  count             = var.enable_codify ? 1 : 0
  name              = "/aws/codebuild/${var.name_prefix}-codify"
  retention_in_days = var.log_retention_days
}

module "codify_source" {
  count  = var.enable_codify && var.package_source ? 1 : 0
  source = "./modules/source-package"

  name       = "codify"
  bucket     = aws_s3_bucket.source[0].id
  source_dir = local.implementation_root
  commit     = var.source_commit
  key_prefix = "payloads"

  # The same payload contents as detection: one package, two entry points. Kept as a separate
  # object so the two stages version independently - changing the codify buildspec should not
  # redeploy detection's source.
  excludes = local.payload_excludes

  tags = { Payload = "codify" }
}

# --- role -------------------------------------------------------------------

# A trust policy of its own, pinned to the CODIFY project. Reusing detection's document does
# not work and should not: it carries a confused-deputy guard restricting aws:SourceArn to the
# detect project, so the codify project's attempt to assume the role is refused. That guard
# doing its job is the correct behaviour - the fix is a document scoped to this project, not a
# wildcard that would let any CodeBuild project in the account assume a role holding a
# repository write credential.
data "aws_iam_policy_document" "codify_assume" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["codebuild.amazonaws.com"]
    }

    condition {
      test     = "StringEquals"
      variable = "aws:SourceAccount"
      values   = [data.aws_caller_identity.current.account_id]
    }

    condition {
      test     = "ArnLike"
      variable = "aws:SourceArn"
      values   = ["arn:aws:codebuild:${var.aws_region}:${data.aws_caller_identity.current.account_id}:project/${var.name_prefix}-codify"]
    }
  }
}

resource "aws_iam_role" "codify" {
  count              = var.enable_codify ? 1 : 0
  name               = "${var.name_prefix}-codify"
  assume_role_policy = data.aws_iam_policy_document.codify_assume.json

  description = "Codify stage: invokes a model and holds a repository write credential. No AWS estate write access, and no Terraform state access."
}

data "aws_iam_policy_document" "codify" {
  statement {
    sid    = "Logs"
    effect = "Allow"

    actions = [
      "logs:CreateLogStream",
      "logs:PutLogEvents",
    ]

    # A splat rather than [0] with a conditional: Terraform evaluates both branches of a
    # ternary, so indexing a count-0 resource errors at plan time even when the condition is
    # false. `validate` does not catch that; only a plan with enable_codify = false does.
    resources = [for arn in aws_cloudwatch_log_group.codify[*].arn : "${arn}:*"]
  }

  # The write credential for the target repository. Scoped to that one secret.
  statement {
    sid       = "ReadGitCredential"
    effect    = "Allow"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [aws_secretsmanager_secret.git_credential.arn]
  }

  # The App private key, when the write path uses App authentication. Scoped to that one
  # secret, exactly like the clone credential.
  dynamic "statement" {
    for_each = var.github_app_key_secret_id == "" ? [] : [1]

    content {
      sid       = "ReadGitHubAppKey"
      effect    = "Allow"
      actions   = ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"]
      resources = [data.aws_secretsmanager_secret.github_app_key[0].arn]
    }
  }

  # Detection's artifacts: the authorization this stage acts on. Read only - the codify stage
  # must not be able to alter the record of what it was authorized to do.
  statement {
    sid       = "ReadDetectionArtifacts"
    effect    = "Allow"
    actions   = ["s3:GetObject", "s3:GetObjectVersion"]
    resources = ["${aws_s3_bucket.artifacts.arn}/*"]
  }

  statement {
    sid       = "ListArtifacts"
    effect    = "Allow"
    actions   = ["s3:ListBucket", "s3:GetBucketLocation"]
    resources = [aws_s3_bucket.artifacts.arn]
  }

  # Its own artifacts.
  statement {
    sid       = "PublishOwnArtifacts"
    effect    = "Allow"
    actions   = ["s3:PutObject"]
    resources = ["${aws_s3_bucket.artifacts.arn}/*"]
  }

  # CodeBuild encrypts uploaded artifacts with KMS, so publishing them needs GenerateDataKey
  # in addition to s3:PutObject. Like Decrypt for the credential, this is a transitive KMS
  # dependency that the deny-everything-except guardrail forces into the open - the honest cost
  # of that approach: it is stricter than denying a named set, and every dependency another
  # service has on this role's behalf must be named. Scoped by ViaService so it cannot
  # be used to encrypt through anything but S3.
  statement {
    sid       = "EncryptOwnArtifacts"
    effect    = "Allow"
    actions   = ["kms:GenerateDataKey", "kms:Encrypt", "kms:DescribeKey"]
    resources = ["*"]

    condition {
      test     = "StringEquals"
      variable = "kms:ViaService"
      values   = ["s3.${var.aws_region}.amazonaws.com"]
    }
  }

  # Reading the credential requires decrypting it. Secrets Manager encrypts with KMS, so
  # secretsmanager:GetSecretValue alone is not sufficient - the caller needs kms:Decrypt via
  # the Secrets Manager service. Scoped by kms:ViaService so this cannot be used to decrypt
  # anything through another service, and so it keeps working if the secret is ever moved from
  # the AWS-managed key to a customer-managed one.
  #
  # Detection does not need this statement because its guardrail denies specific actions;
  # this role's guardrail denies everything except an enumerated list, which is stricter and
  # therefore has to name transitive dependencies like this one explicitly.
  statement {
    sid       = "DecryptTheCredential"
    effect    = "Allow"
    actions   = ["kms:Decrypt"]
    resources = ["*"]

    condition {
      test     = "StringEquals"
      variable = "kms:ViaService"
      values   = ["secretsmanager.${var.aws_region}.amazonaws.com"]
    }
  }

  # Exactly one model, named. A wildcard here would let a compromised worker invoke anything
  # in the account's Bedrock catalogue, including models with different data-handling terms.
  statement {
    sid    = "InvokeTheAgentModel"
    effect = "Allow"

    actions = [
      "bedrock:InvokeModel",
      "bedrock:InvokeModelWithResponseStream",
    ]

    resources = var.model_invoke_arns
  }

  # Fetching its own source, when Terraform packaged it.
  dynamic "statement" {
    for_each = var.package_source && var.enable_codify ? [1] : []

    content {
      sid       = "FetchOwnSource"
      effect    = "Allow"
      actions   = ["s3:GetObject", "s3:GetObjectVersion"]
      resources = [module.codify_source[0].object_arn]
    }
  }

  dynamic "statement" {
    for_each = var.package_source && var.enable_codify ? [1] : []

    content {
      sid       = "ResolveOwnSource"
      effect    = "Allow"
      actions   = ["s3:GetBucketLocation", "s3:ListBucket"]
      resources = [aws_s3_bucket.source[0].arn]
    }
  }
}

# The guarantee that bounds the blast radius: this principal cannot change the estate, cannot
# touch Terraform state, and cannot read secrets other than its own. An explicit Deny, so no
# managed policy attached later can widen it by accident.
data "aws_iam_policy_document" "codify_guardrails" {
  statement {
    sid    = "DenyEstateMutation"
    effect = "Deny"

    # Anything that changes infrastructure. The codify stage plans against a checkout; it has
    # no reason to alter a resource, and if it ever tried, this is where it stops.
    #
    # Deny-everything-except is stricter than denying a named set, and the cost is that every
    # transitive dependency has to appear here. kms:Decrypt is the example that proves the
    # point: it is not something this stage does deliberately, it is what Secrets Manager needs
    # underneath GetSecretValue, and omitting it fails the build at DOWNLOAD_SOURCE with an
    # error naming KMS rather than the policy. Anything added below should be reviewed as a
    # widening, and the ViaService condition on the allow is what keeps this one narrow.
    not_actions = [
      "logs:CreateLogStream",
      "logs:PutLogEvents",
      "s3:PutObject",
      "s3:GetObject",
      "s3:GetObjectVersion",
      "s3:ListBucket",
      "s3:GetBucketLocation",
      "secretsmanager:GetSecretValue",
      "kms:Decrypt",
      "kms:GenerateDataKey",
      "kms:Encrypt",
      "kms:DescribeKey",
      "bedrock:InvokeModel",
      "bedrock:InvokeModelWithResponseStream",
      "sts:AssumeRole",
      "sts:GetCallerIdentity",
    ]

    resources = ["*"]
  }

  # Terraform state, explicitly. The codify stage runs `plan`, which for a workspace with a
  # remote backend would read state - so it must be denied outright rather than left to the
  # absence of a grant. A plan that cannot read state fails loudly, which is the correct
  # outcome: this stage is meant to scan a checkout, not the deployed estate.
  statement {
    sid    = "DenyStateAccess"
    effect = "Deny"

    actions = [
      "s3:GetObject",
      "s3:PutObject",
      "s3:DeleteObject",
    ]

    resources = [
      "arn:aws:s3:::${var.target_state_bucket}/*",
    ]
  }
}

resource "aws_iam_role_policy" "codify" {
  count  = var.enable_codify ? 1 : 0
  name   = "${var.name_prefix}-codify-runtime"
  role   = aws_iam_role.codify[0].id
  policy = data.aws_iam_policy_document.codify.json
}

resource "aws_iam_role_policy" "codify_guardrails" {
  count  = var.enable_codify ? 1 : 0
  name   = "${var.name_prefix}-codify-guardrails"
  role   = aws_iam_role.codify[0].id
  policy = data.aws_iam_policy_document.codify_guardrails.json
}

# --- project ----------------------------------------------------------------

resource "aws_codebuild_project" "codify" {
  count = var.enable_codify ? 1 : 0

  name          = "${var.name_prefix}-codify"
  description   = "Agent drafts the codified change; it is verified against the work order, scanned, and opened as a pull request."
  service_role  = aws_iam_role.codify[0].arn
  build_timeout = var.build_timeout_minutes

  artifacts {
    type      = "S3"
    location  = aws_s3_bucket.artifacts.bucket
    packaging = "ZIP"
  }

  environment {
    type         = "LINUX_CONTAINER"
    compute_type = "BUILD_GENERAL1_SMALL"
    image        = "aws/codebuild/standard:7.0"

    environment_variable {
      name  = "TARGET_REPO_URL"
      value = var.target_repo_url
    }

    environment_variable {
      name  = "TARGET_REPO_SLUG"
      value = var.target_repo_slug
    }

    environment_variable {
      name  = "TARGET_REPO_REF"
      value = var.target_repo_ref
    }

    environment_variable {
      name  = "TF_WORKING_DIR"
      value = var.target_working_dir
    }

    environment_variable {
      name  = "GIT_CREDENTIAL_SECRET_ID"
      value = aws_secretsmanager_secret.git_credential.name
    }

    environment_variable {
      name  = "DRIFT_WORKSPACE_ID"
      value = var.workspace_id
    }

    environment_variable {
      name  = "DRIFT_MODEL_ID"
      value = var.model_id
    }

    environment_variable {
      name  = "DRIFT_ARTIFACTS_BUCKET"
      value = aws_s3_bucket.artifacts.bucket
    }

    # When both are set the write path prefers App authentication. Empty means fall back to the
    # personal access token, so this can be adopted without a flag day.
    environment_variable {
      name  = "DRIFT_GITHUB_APP_ID"
      value = var.github_app_id
    }

    environment_variable {
      name  = "DRIFT_GITHUB_APP_KEY_SECRET_ID"
      value = var.github_app_key_secret_id
    }

    # Set per invocation by whatever starts this build, naming the detection run to act on.
    # Deliberately not defaulted: acting on an unspecified authorization would mean codifying
    # whatever happened to be latest.
    environment_variable {
      name  = "DETECTION_ARTIFACT_KEY"
      value = "SET_PER_BUILD"
    }
  }

  source {
    type      = local.effective_codify_source_type
    location  = local.effective_codify_source_location
    buildspec = "buildspec-codify.yml"

    git_clone_depth = local.effective_codify_source_type == "S3" ? null : 1
  }

  logs_config {
    cloudwatch_logs {
      group_name = aws_cloudwatch_log_group.codify[0].name
    }
  }
}

locals {
  effective_codify_source_type = var.package_source ? "S3" : var.source_type

  # one() over a splat, not [0] behind a conditional: Terraform evaluates both branches of a
  # ternary, so [0] on a count-0 module is an index error even when the condition is false -
  # which would make enable_codify = false fail to plan at all. Both branches here are
  # index-free, so neither can fault.
  #
  # An explicit null check rather than coalesce(): coalesce treats "" as absent as well as
  # null, so with no package and no source_location it raises instead of yielding "".
  codify_packaged_location = one(module.codify_source[*].s3_location)

  effective_codify_source_location = (
    local.codify_packaged_location != null
    ? local.codify_packaged_location
    : var.source_location
  )
}
